<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test-only validation Worker. It has no compile-time reference to any game
    file: every game/engine member is bound by reflection at run time (see
    GameApi.cs), so this project builds in public CI without game files.
    The Microsoft.Extensions.Logging packages are compile-time only; at run time
    the copies shipped with the user's game install are used.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RimWorldValidationWorker</AssemblyName>
    <RootNamespace>RimWorldValidation.Worker</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
